# Elasticsearch Serverless project "FoodInsights"
ES_URL=https://foodinsights-xxxxxx.es.eastus.azure.elastic.cloud
ES_API_KEY=

# EIS endpoints (defaults; change only if you create custom ones)
EIS_OCR_CHAT_ENDPOINT=.jina-ocr-v1-chat_completion
EIS_OCR_DOCX_ENDPOINT=label-ocr
EIS_HAMMER_ENDPOINT=.google-gemini-3.8-flash-chat_completion

# Fill in from the Serverless pricing table (USD per million tokens)
EIS_OCR_PRICE_PER_MTOK_IN=
EIS_OCR_PRICE_PER_MTOK_OUT=

# Open Food Facts etiquette
OFF_USER_AGENT=FoodInsights/0.1 (suyash.joshi@elastic.co)

# Index
ES_INDEX=food_labels
