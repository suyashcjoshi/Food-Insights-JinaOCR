# Elasticsearch Serverless project "FoodInsights"
ES_URL=https://foodinsights-xxxxxx.es.eastus.azure.elastic.cloud
ES_API_KEY=

# EIS endpoint (default; change only if you create a custom one)
EIS_OCR_DOCX_ENDPOINT=.jina-reader

# Open Food Facts etiquette
# Only for scripts/fetch_off_sample.py. Use your own contact; do not commit a real one.
OFF_USER_AGENT=FoodInsights/0.1 (your-contact@example.com)

# Index
ES_INDEX=food_labels
